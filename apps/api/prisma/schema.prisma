generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadSourceSite {
  FORMATION
  TECHNOLOGY

  @@map("lead_source_site")
}

enum LeadLocale {
  EN
  ES

  @@map("lead_locale")
}

enum LeadInterest {
  COMPANY_FORMATION
  TAX_SERVICES
  ANNUAL_COMPLIANCE
  BANKING_AND_PAYMENTS
  TECHNOLOGY_AND_DIGITAL
  IN_PERSON_WORKSHOP
  OTHER

  @@map("lead_interest")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED

  @@map("lead_status")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

model Lead {
  id                         String              @id @default(uuid()) @db.Uuid
  sourceSite                 LeadSourceSite      @map("source_site")
  locale                     LeadLocale          @map("locale")
  interest                   LeadInterest        @map("interest")
  status                     LeadStatus          @default(NEW) @map("status")
  fullName                   String              @map("full_name") @db.VarChar(160)
  email                      String              @map("email") @db.VarChar(320)
  phone                      String?             @map("phone") @db.VarChar(40)
  country                    String              @map("country") @db.VarChar(100)
  company                    String?             @map("company") @db.VarChar(160)
  message                    String              @map("message") @db.VarChar(2000)
  privacyConsentAt           DateTime            @map("privacy_consent_at") @db.Timestamptz(3)
  campaign                   String?             @map("campaign") @db.VarChar(255)
  utmSource                  String?             @map("utm_source") @db.VarChar(255)
  utmMedium                  String?             @map("utm_medium") @db.VarChar(255)
  utmCampaign                String?             @map("utm_campaign") @db.VarChar(255)
  internalNotificationStatus EmailDeliveryStatus @default(PENDING) @map("internal_notification_status")
  visitorConfirmationStatus  EmailDeliveryStatus @default(PENDING) @map("visitor_confirmation_status")
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt], map: "leads_status_created_at_idx")
  @@index([sourceSite, createdAt], map: "leads_source_site_created_at_idx")
  @@index([interest, createdAt], map: "leads_interest_created_at_idx")
  @@index([email], map: "leads_email_idx")
  @@map("leads")
}
