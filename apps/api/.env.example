# Server-only configuration. Replace placeholders in a local or deployment-only
# environment file; never commit credentials.
NODE_ENV=development
PORT=3001
PUBLIC_WEB_ORIGINS=http://localhost:3002
# Set only when a reverse proxy connects to the API over loopback.
TRUST_PROXY=
DATABASE_URL=<set-in-local-or-deployment-environment>
MIGRATION_DATABASE_URL=<set-in-local-or-deployment-environment>
RESEND_API_KEY=<set-in-local-or-deployment-environment>
RESEND_FROM_EMAIL=<set-in-local-or-deployment-environment>
LEADS_NOTIFICATION_TO=<set-in-local-or-deployment-environment>
